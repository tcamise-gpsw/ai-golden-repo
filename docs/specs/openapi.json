{
  "openapi": "3.1.0",
  "info": {
    "title": "Hello World API",
    "description": "Returns languages and dynamic Hello World translations.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/languages": {
      "get": {
        "summary": "List Languages",
        "description": "Return every language available for translation.",
        "operationId": "list_languages_api_languages_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Language"
                  },
                  "type": "array",
                  "title": "Response List Languages Api Languages Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/translate/{code}": {
      "get": {
        "summary": "Translate Greeting",
        "description": "Return a dynamic Hello World translation for a supported language.",
        "operationId": "translate_greeting_api_translate__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslatedGreeting"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Language": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language",
            "description": "English name of the language."
          },
          "native_name": {
            "type": "string",
            "title": "Native Name",
            "description": "Language name written in its own script."
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Language code accepted by the translation service."
          }
        },
        "type": "object",
        "required": [
          "language",
          "native_name",
          "code"
        ],
        "title": "Language",
        "description": "A language available for translation."
      },
      "TranslatedGreeting": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language",
            "description": "English name of the language."
          },
          "native_name": {
            "type": "string",
            "title": "Native Name",
            "description": "Language name written in its own script."
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Language code accepted by the translation service."
          },
          "greeting": {
            "type": "string",
            "title": "Greeting",
            "description": "Hello, World! translated into the language."
          }
        },
        "type": "object",
        "required": [
          "language",
          "native_name",
          "code",
          "greeting"
        ],
        "title": "TranslatedGreeting",
        "description": "A translated Hello World greeting for one language."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
